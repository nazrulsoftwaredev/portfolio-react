{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": "backend",
    "types": ["node"]
  },
  "include": ["backend/**/*.ts", "backend/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
