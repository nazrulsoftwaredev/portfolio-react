# API Configuration
VITE_API_URL=http://localhost:5000/api

# Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=portfolio_react
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-a-32-char-min-secret-value
JWT_REFRESH_SECRET=replace-with-a-second-32-char-min-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_COOKIE_NAME=pr_access
REFRESH_COOKIE_NAME=pr_refresh
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@mdnazrul.com
ADMIN_PASSWORD=admin12345

# Sentry Configuration (Production)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=1.0.0

# App Configuration
VITE_APP_NAME=Portfolio
